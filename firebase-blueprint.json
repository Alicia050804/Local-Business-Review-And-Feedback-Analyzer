{
  "entities": {
    "Business": {
      "title": "Business",
      "description": "A public neighborhood business listing in the shared directory.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Business identifier.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the business owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Business name.",
          "minLength": 1,
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "description": "Business category.",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "description": "Business description.",
          "minLength": 1,
          "maxLength": 800
        },
        "imageUrl": {
          "type": "string",
          "description": "Optional image URL or bundled asset path.",
          "maxLength": 300
        },
        "isPublic": {
          "type": "boolean",
          "description": "Marks directory listing as publicly readable."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp on creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp on update."
        }
      },
      "required": ["id", "ownerId", "name", "category", "description", "isPublic", "createdAt", "updatedAt"]
    },
    "Review": {
      "title": "Review",
      "description": "Community member feedback and optional owner/staff reply for a business.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Review identifier.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "businessId": {
          "type": "string",
          "description": "Parent business identifier.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorUid": {
          "type": "string",
          "description": "Firebase Auth UID of the community member who wrote the review.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "author": {
          "type": "string",
          "description": "Reviewer display name.",
          "minLength": 1,
          "maxLength": 60
        },
        "rating": {
          "type": "number",
          "description": "Star rating from 1 to 5."
        },
        "date": {
          "type": "string",
          "description": "Display date string (YYYY-MM-DD).",
          "minLength": 1,
          "maxLength": 32
        },
        "comment": {
          "type": "string",
          "description": "Customer feedback comment.",
          "minLength": 1,
          "maxLength": 1000
        },
        "isPublic": {
          "type": "boolean",
          "description": "Marks review as publicly readable."
        },
        "ownerReply": {
          "type": "object",
          "description": "Optional reply sent by the business owner or authorized staff."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp on creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp on creation or owner reply."
        }
      },
      "required": ["id", "businessId", "authorUid", "author", "rating", "date", "comment", "isPublic", "createdAt", "updatedAt"]
    },
    "CommunityPost": {
      "title": "CommunityPost",
      "description": "An owner/staff update (special, event, or job) for a business.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Post identifier.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "businessId": {
          "type": "string",
          "description": "Parent business identifier.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorUid": {
          "type": "string",
          "description": "Firebase Auth UID of the owner or staff member.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "type": {
          "type": "string",
          "description": "Category of community post.",
          "enum": ["specials", "events", "jobs"]
        },
        "title": {
          "type": "string",
          "description": "Headline of the post.",
          "minLength": 1,
          "maxLength": 140
        },
        "details": {
          "type": "string",
          "description": "Details, price, or application instructions.",
          "minLength": 1,
          "maxLength": 1000
        },
        "date": {
          "type": "string",
          "description": "Schedule or date text.",
          "minLength": 1,
          "maxLength": 64
        },
        "isPublic": {
          "type": "boolean",
          "description": "Marks post as publicly readable."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp on creation."
        }
      },
      "required": ["id", "businessId", "authorUid", "type", "title", "details", "date", "isPublic", "createdAt"]
    },
    "SavedAnalysis": {
      "title": "SavedAnalysis",
      "description": "Saved Gemini AI customer feedback analysis for a business.",
      "type": "object",
      "properties": {
        "businessId": {
          "type": "string",
          "description": "Parent business identifier.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorUid": {
          "type": "string",
          "description": "Firebase Auth UID of user saving the analysis.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "signature": {
          "type": "string",
          "description": "Review signature string matching analyzed reviews.",
          "minLength": 1,
          "maxLength": 5000
        },
        "summary": {
          "type": "string",
          "description": "Overall service sentiment summary.",
          "maxLength": 1000
        },
        "loves": {
          "type": "array",
          "description": "What customers love about the service (up to 6 items)."
        },
        "unhappy": {
          "type": "array",
          "description": "What customers are unhappy about (up to 6 items)."
        },
        "actions": {
          "type": "array",
          "description": "What owners can do to improve (up to 6 items)."
        },
        "isPublic": {
          "type": "boolean",
          "description": "Marks insights as publicly readable."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when analysis was saved."
        }
      },
      "required": ["businessId", "authorUid", "signature", "summary", "loves", "unhappy", "actions", "isPublic", "updatedAt"]
    },
    "StaffMember": {
      "title": "StaffMember",
      "description": "Authorized staff or manager email granted access to a business's Staff Portal.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Normalized email key identifier.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "businessId": {
          "type": "string",
          "description": "Parent business identifier.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the business owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "description": "Lowercase Google email address of the authorized staff member.",
          "minLength": 3,
          "maxLength": 160
        },
        "role": {
          "type": "string",
          "description": "Role label shown on replies.",
          "enum": ["Owner", "Manager", "Staff"]
        },
        "addedByUid": {
          "type": "string",
          "description": "UID of the owner/admin who authorized this staff member.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp on creation."
        }
      },
      "required": ["id", "businessId", "ownerId", "email", "role", "addedByUid", "createdAt"]
    }
  },
  "firestore": {
    "/businesses/{businessId}": {
      "schema": { "$ref": "#/entities/Business" },
      "description": "Public neighborhood business listings managed by owners and admins."
    },
    "/businesses/{businessId}/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Community feedback for a business, including owner/staff replies."
    },
    "/businesses/{businessId}/posts/{postId}": {
      "schema": { "$ref": "#/entities/CommunityPost" },
      "description": "Owner/staff specials, events, and job posts for a business."
    },
    "/businesses/{businessId}/analyses/{analysisId}": {
      "schema": { "$ref": "#/entities/SavedAnalysis" },
      "description": "AI customer feedback insights for a business."
    },
    "/businesses/{businessId}/staffMembers/{memberId}": {
      "schema": { "$ref": "#/entities/StaffMember" },
      "description": "Private staff authorization records scoped to a business."
    }
  }
}
